-- Wheel-spin test: log only. Core world position/velocity plus _WY of every Wheel/RLW chip (up to 6).
n=0
buf=""
wrote=-9
lasterr="none"
function OnInit()
	n=0
	buf="frame,x,y,z,vx,vy,vz,ex,ey,ez,w0,w1,w2,w3,w4,w5\n"
end

function step()
	local ws={}
	for c=0,_CHIPS()-1 do
		local t=_TYPE(c)
		if (t==4 or t==5) and table.getn(ws)<6 then table.insert(ws,_WY(c)) end
	end
	while table.getn(ws)<6 do table.insert(ws,0) end
	if n<=330 then
		buf=buf..n..","..
			_X(0)..",".._Y(0)..",".._Z(0)..","..
			_VX(0)..",".._VY(0)..",".._VZ(0)..","..
			_EX(0)..",".._EY(0)..",".._EZ(0)..","..
			ws[1]..","..ws[2]..","..ws[3]..","..ws[4]..","..ws[5]..","..ws[6].."\n"
	end
	if n==330 then
		local h=_FOPEN("log.txt","w")
		if h>=0 then _FPUTS(h,buf) _FCLOSE(h) wrote=h else wrote=-1 end
	end
end

function OnFrame()
	n=n+1
	local ok,err=pcall(step)
	if not ok then lasterr=tostring(err) end
	out(0,"frame ",n," wrote ",wrote)
	out(1,"err ",lasterr)
end

function OnReset()
end
