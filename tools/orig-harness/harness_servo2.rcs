-- Servo semantics probe: log x,y,z of chips 0..9 every frame to 330 (the model's own Lua moves a hip joint at 150)
n=0
buf=""
wrote=-9
lasterr="none"
function OnInit()
	n=0
	local h="frame"
	for c=0,9 do h=h..",x"..c..",y"..c..",z"..c end
	buf=h.."\n"
end

function step()
	local row=""..n
	for c=0,9 do
		if c<_CHIPS() then row=row..",".._X(c)..",".._Y(c)..",".._Z(c) else row=row..",,," end
	end
	if n<=330 then buf=buf..row.."\n" end
	if n==330 then
		local h=_FOPEN("log.txt","w")
		if h>=0 then _FPUTS(h,buf) _FCLOSE(h) wrote=h else wrote=-1 end
	end
end

function OnFrame()
	n=n+1
	local ok,err=pcall(step)
	if not ok then lasterr=tostring(err) end
	out(0,"frame ",n," wrote ",wrote)
	out(1,"err ",lasterr)
end

function OnReset()
end
