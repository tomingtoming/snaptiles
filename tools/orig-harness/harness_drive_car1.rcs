-- harness_drive.rcs plus car1 detail: wing Trim pitch (_EX of chips 3,4,58,59), wheel _H and _WY (chips 10,15,52,56)
n=0
buf=""
wrote=-9
LAST=600
function OnInit()
	n=0
	buf="frame,key0,x,y,z,vx,vy,vz,ex,ey,ez,chips,w3,w4,w58,w59,h10,h15,h52,h56,wy10,wy15,wy52,wy56\n"
end
function step()
	if n<=LAST then
		buf=buf..n..",".._KEY(0)..",".._X(0)..",".._Y(0)..",".._Z(0)..",".._VX(0)..",".._VY(0)..",".._VZ(0)..","..
			_EX(0)..",".._EY(0)..",".._EZ(0)..",".._CHIPS()..",".._EX(3)..",".._EX(4)..",".._EX(58)..",".._EX(59)..","..
			_H(10)..",".._H(15)..",".._H(52)..",".._H(56)..",".._WY(10)..",".._WY(15)..",".._WY(52)..",".._WY(56).."\n"
	end
	if n==LAST then
		local h=_FOPEN("log.txt","w")
		if h>=0 then _FPUTS(h,buf) _FCLOSE(h) wrote=h else wrote=-1 end
	end
end
function OnFrame()
	n=n+1
	pcall(step)
	out(0,"frame ",n," wrote ",wrote)
end
function OnReset() end
